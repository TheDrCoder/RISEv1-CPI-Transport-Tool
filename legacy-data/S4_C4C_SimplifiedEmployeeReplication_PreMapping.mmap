	return "";
}

else {

		return ( input.substring(30));
}</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"><argument jtp="String" nm="id" tp="0"><uiTitle></uiTitle></argument></signature><name>removeleadingzeroes</name><key>removeleadingzeroes</key><tab>User-Defined</tab><title>removeLeadingZeroes</title><uiTitle>removeLeadingZeroes</uiTitle><implementation type="udf"><javaText>// This function will remove all leading zeros if the input string is non-alphaneumeric 
	int idAsInt = 0;
		try {
			 idAsInt = Integer.parseInt(id);
		}
		catch (java.lang.NumberFormatException e)
		{
		// if id is not numeric, just return it
			return id ;
		}
		return String.valueOf(idAsInt);</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"/><name>CurrentUTC_Time</name><key>CurrentUTC_Time</key><tab>User-Defined</tab><title>CurrentUTC_Time</title><uiTitle></uiTitle><implementation type="udf"><javaText>        final SimpleDateFormat f = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss z");
        f.setTimeZone(TimeZone.getTimeZone("UTC"));
        String UTC_date =  f.format(new Date());
        UTC_date = UTC_date.substring(0, UTC_date.length() - 4);
        return(UTC_date);</javaText></implementation></functionmodel><functionmodel><signature cacheType="1"><argument jtp="String" nm="StartDate" tp="0"><uiTitle></uiTitle></argument><argument jtp="ResultList" nm="result" tp="1"><uiTitle></uiTitle></argument><argument jtp="String" nm="CurrentDate" tp="0"><uiTitle></uiTitle></argument><argument jtp="String" nm="EndDate" tp="0"><uiTitle></uiTitle></argument></signature><name>IsSubTypeValid</name><key>IsSubTypeValid</key><tab>User-Defined</tab><title>IsSubTypeValid</title><uiTitle></uiTitle><implementation type="udf"><javaText>	
		for ( int i = 0 ; i &lt; StartDate.length; i++ ){

			if ( StartDate[i].equals(ResultList.CC)){
				  
				 result.addValue("false");
				
			}
			
			else {
				   int compareStart = StartDate[i].compareTo(CurrentDate[0]);
				   int compareEnd   = CurrentDate[0].compareTo(EndDate[i]);
				   if ( (compareStart  * compareEnd ) &gt;= 0){
							   result.addValue(true);
				   }
				   else{
				    result.addValue(false);
				   }
				
			}
}
		   </javaText></implementation></functionmodel><usedjars/></functionstorage></entry><entry name="compareDates"><libref><ref pos="1" role="UsedFuncLib"><key><key typeID="gsh" version="1.1"><elem>compareDates.groovy</elem><elem>src/main/resources/script</elem></key></key></ref></libref></entry></libstorage><transformation><brick gid="0" path="/HRMD_A09" type="Dst"><viewData x="190" y="25"/><arg><brick gid="0" path="/HRMD_A09" type="Src"><viewData x="50" y="25"/></brick></arg><group/></brick><brick gid="0" path="/HRMD_A09/IDOC" type="Dst"><viewData x="0" y="0"/><arg><brick gid="0" path="/HRMD_A09/IDOC" type="Src"><viewData x="0" y="0"/></brick></arg><group/></brick><brick gid="0" path="/HRMD_A09/IDOC/@BEGIN" type="Dst"><viewData x="0" y="0"/><arg><brick gid="0" path="/HRMD_A09/IDOC/@BEGIN" type="Src"><viewData x="0" y="0"/></brick></arg><group/></brick><brick gid="0" path="/HRMD_A09/IDOC/EDI_DC40" type="Dst"><viewData x="0" y="0"/><arg><brick gid="0" path="/HRMD_A09/IDOC/EDI_DC40" type="Src"><viewData x="0" y="0"/></brick></arg><group/></brick><brick gid="0" path="/HRMD_A09/IDOC/EDI_DC40/@SEGMENT" type="Dst"><viewData x="0" y="0"/><arg><brick gid="0" path="/HRMD_A09/IDOC/EDI_DC40/@SEGMENT" type="Src"><viewData x="0" y="0"/></brick></arg><group/></brick><brick gid="0" path="/HRMD_A09/IDOC/EDI_DC40/TABNAM" type="Dst"><viewData x="0" y="0"/><arg><brick gid="0" path="/HRMD_A09/IDOC/EDI_DC40/TABNAM" type="Src"><viewData x="0" y="0"/></brick></arg><group/></brick><brick gid="0" path="/HRMD_A09/IDOC/EDI_DC40/MANDT" type="Dst"><viewData x="0" y="0"/><arg><brick gid="0" path="/HRMD_A09/IDOC/EDI_DC40/MANDT" type="Src"><viewData x="0" y="0"/></brick></arg><group/></brick><brick gid="0" path="/HRMD_A09/IDOC/EDI_DC40/DOCNUM" type="Dst"><viewData x="0" y="0"/><arg><brick gid="0" path="/HRMD_A09/IDOC/EDI_DC40/DOCNUM" type="Src"><viewData x="0" y="0"/></brick></arg><group/></brick><brick gid="0" path="/HRMD_A09/IDOC/EDI_DC40/DOCREL" type="Dst"><viewData x="0" y="0"/><arg><brick gid=