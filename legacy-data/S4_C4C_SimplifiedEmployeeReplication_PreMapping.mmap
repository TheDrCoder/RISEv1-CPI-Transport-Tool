}</javaText></implementation></functionmodel><functionmodel><signature cacheType="2"><argument jtp="String" nm="var1" tp="0"><uiTitle></uiTitle></argument><argument jtp="ResultList" nm="result" tp="1"><uiTitle></uiTitle></argument></signature><name>FillUserAccountsInactiveIndicator</name><key>325a9d13-0178-11eb-9484-020100000425</key><tab>User-Defined</tab><title>FillUserAccountsInactiveIndicator</title><uiTitle></uiTitle><implementation type="udf"><javaText>int flag=0;
for ( int i = 0 ; i &lt; var1.length; i++ )
{
	if (var1[i].equals("true"))
	{
			flag=1;
			break;
	}
}

if (flag==1)
	result.addValue("false");
else
	result.addValue("true");</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"/><name>getMessageID</name><key>calculate1</key><tab>User-Defined</tab><title>getMessageID</title><uiTitle></uiTitle><implementation type="udf"><javaText> //read container parameter collection and then the Message ID from it
 String MessageID;
java.util.Map param = container.getTransformationParameters();
MessageID = (String) param.get (StreamTransformationConstants.MESSAGE_ID);
return MessageID.toUpperCase();</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"><argument jtp="String" nm="var1" tp="0"><uiTitle></uiTitle></argument></signature><name>formatDateTime</name><key>formatDateTime</key><tab>User-Defined</tab><title>formatDateTime</title><uiTitle></uiTitle><implementation type="udf"><javaText>String out = "";

 if (var1 != null &amp;&amp; !var1.equals("") &amp;&amp; var1.length() &gt;= 21)
{
	out = (var1.substring(0, 4)+"-"+var1.substring(4, 6)+"-"+var1.substring(6, 8)+"T"+var1.substring(8,  10)+":"+var1.substring(10,12)+":"+var1.substring(12,14)+"."+var1.substring(14,21)+"Z");
}

return out;
</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"><argument jtp="String" nm="uuid" tp="0"><uiTitle></uiTitle></argument></signature><name>formatUUID</name><key>formatUUID</key><tab>User-Defined</tab><title>formatUUID</title><uiTitle></uiTitle><implementation type="udf"><javaText>// This Code will format UUID to SOD accepted format
String out = "";

 if (uuid != null &amp;&amp; !uuid.equals(""))
{
	out = (uuid.substring(0,8)+"-"+uuid.substring(8, 12)+"-"+uuid.substring(12, 		16)+"-"+uuid.substring(16,20)+"-"+uuid.substring(20));
 }

return out;</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"><argument jtp="String" nm="input" tp="0"><uiTitle></uiTitle></argument></signature><name>StringSplit</name><key>StringSplit</key><tab>User-Defined</tab><title>StringSplit</title><uiTitle>StringSplit</uiTitle><implementation type="udf"><javaText>
// This function return 1st 30character of string 

if ( input.length() &lt;=30 ) {
return input;
}

else {
return (input.substring(0,30));

}

</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"><argument jtp="String" nm="input" tp="0"><uiTitle></uiTitle></argument></signature><name>PhoneExtentionSplit</name><key>PhoneExtentionSplit</key><tab>User-Defined</tab><title>PhoneExtentionSplit</title><uiTitle>PhoneExtentionSplit</uiTitle><implementation type="udf"><javaText>
