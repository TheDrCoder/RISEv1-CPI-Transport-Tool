}</javaText></implementation></functionmodel><functionmodel><signature cacheType="2"><argument jtp="String" nm="var1" tp="0"><uiTitle/></argument><argument jtp="ResultList" nm="result" tp="1"><uiTitle/></argument></signature><name>FillUserAccountsInactiveIndicator</name><key>325a9d13-0178-11eb-9484-020100000425</key><tab>User-Defined</tab><title>FillUserAccountsInactiveIndicator</title><uiTitle/><implementation type="udf"><javaText>int flag=0;
for ( int i = 0 ; i &lt; var1.length; i++ )
{
	if (var1[i].equals("true"))
	{
			flag=1;
			break;
	}
if (flag==1)
	result.addValue("false");
else
	result.addValue("true");
}

</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"/><name>getMessageID</name><key>calculate1</key><tab>User-Defined</tab><title>getMessageID</title><uiTitle/><implementation type="udf"><javaText> //read container parameter collection and then the Message ID from it
 String MessageID;
java.util.Map param = container.getTransformationParameters();
MessageID = (String) param.get (StreamTransformationConstants.MESSAGE_ID);
return MessageID.toUpperCase();</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"><argument jtp="String" nm="var1" tp="0"><uiTitle/></argument></signature><name>formatDateTime</name><key>formatDateTime</key><tab>User-Defined</tab><title>formatDateTime</title><uiTitle/><implementation type="udf"><javaText>String out = "";

 if (var1 != null &amp;&amp; !var1.equals("") &amp;&amp; var1.length() &gt;= 21)
{
	out = (var1.substring(0, 4)+"-"+var1.substring(4, 6)+"-"+var1.substring(6, 8)+"T"+var1.substring(8,  10)+":"+var1.substring(10,12)+":"+var1.substring(12,14)+"."+var1.substring(14,21)+"Z");
}

return out;
</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"><argument jtp="String" nm="uuid" tp="0"><uiTitle/></argument></signature><name>formatUUID</name><key>formatUUID</key><tab>User-Defined</tab><title>formatUUID</title><uiTitle/><implementation type="udf"><javaText>// This Code will format UUID to SOD accepted format
String out = "";

 if (uuid != null &amp;&amp; !uuid.equals(""))
{
	out = (uuid.substring(0,8)+"-"+uuid.substring(8, 12)+"-"+uuid.substring(12, 		16)+"-"+uuid.substring(16,20)+"-"+uuid.substring(20));
 }

return out;</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"><argument jtp="String" nm="input" tp="0"><uiTitle/></argument></signature><name>StringSplit</name><key>StringSplit</key><tab>User-Defined</tab><title>StringSplit</title><uiTitle>StringSplit</uiTitle><implementation type="udf"><javaText>
// This function return 1st 30character of string 

if ( input.length() &lt;=30 ) {
return input;
}

else {
return (input.substring(0,30));

}

</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"><argument jtp="String" nm="input" tp="0"><uiTitle/></argument></signature><name>PhoneExtentionSplit</name><key>PhoneExtentionSplit</key><tab>User-Defined</tab><title>PhoneExtentionSplit</title><uiTitle>PhoneExtentionSplit</uiTitle><implementation type="udf"><javaText>
if ( input.length() &lt;= 30 ){

	return "";
}

else {

		return ( input.substring(30));
}</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"><argument jtp="String" nm="id" tp="0"><uiTitle/></argument></signature><name>removeleadingzeroes</name><key>removeleadingzeroes</key><tab>User-Defined</tab><title>removeLeadingZeroes</title><uiTitle>removeLeadingZeroes</uiTitle><implementation type="udf"><javaText>// This function will remove all leading zeros if the input string is non-alphaneumeric 
	int idAsInt = 0;
		try {
			 idAsInt = Integer.parseInt(id);
		}
		catch (java.lang.NumberFormatException e)
		{
		// if id is not numeric, just return it
			return id ;
		}
		return String.valueOf(idAsInt);</javaText></implementation></functionmodel><functionmodel><signature cacheType="0"/><name>CurrentUTC_Time</name><key>CurrentUTC_Time</key><tab>User-Defined</tab><title>CurrentUTC_Time</title><uiTitle/><implementation type="udf"><javaText>        final SimpleDateFormat f = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss z");
        f.setTimeZone(TimeZone.getTimeZone("UTC"));
        String UTC_date =  f.format(new Date());
        UTC_date = UTC_date.substring(0, UTC_date.length() - 4);
        return(UTC_date);</javaText></implementation></functionmodel><functionmodel><signature cacheType="1"><argument jtp="String" nm="StartDate" tp="0"><uiTitle/></argument><argument jtp="ResultList" nm="result" tp="1"><uiTitle/></argument><argument jtp="String" nm="CurrentDate" tp="0"><uiTitle/></argument><argument jtp="String" nm="EndDate" tp="0"><uiTitle/></argument></signature><name>IsSubTypeValid</name><key>IsSubTypeValid</key><tab>User-Defined</tab><title>IsSubTypeValid</title><uiTitle/><implementation type="udf"><javaText>	
		for ( int i = 0 ; i &lt; StartDate.length; i++ ){

			if ( StartDate[i].equals(ResultList.CC)){
				  
				 result.addValue("false");
				
			}
			
			else {
				   int compareStart = StartDate[i].compareTo(CurrentDate[0]);
				   int compareEnd   = CurrentDate[0].compareTo(EndDate[i]);
				   if ( (compareStart  * compareEnd ) &gt;= 0){
							   result.addValue(true);
				   }
				   else{
				    result.addValue(false);
				   }
				
			}
}
