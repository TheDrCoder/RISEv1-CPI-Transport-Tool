for(int i=0; i&lt;subty.length ;i++)
{

	if	(subty[i].equals("0001") ) 
	{
			userid_out.addValue(userid[i]);
	 		j++;
	 }

	else if	(subty[i].equals("0005") ) 
	{
			userid_out.addValue(userid[i]);
	 		j++;
	}

	else if	(subty[i].equals("CELL") ) 
	{
			userid_out.addValue(userid[i]);
	 	j++;
	}

	else
			userid_out.addValue("");
}

</javaText></implementation></functionmodel><functionmodel><signature cacheType="1"><argument jtp="String" nm="useridlong" tp="0"><uiTitle/></argument><argument jtp="String" nm="subty" tp="0"><uiTitle/></argument><argument jtp="ResultList" nm="userid_out" tp="1"><uiTitle/></argument></signature><name>formatUserIdLong</name><key>1b2c7ef0-67e4-11e8-cde6-507b9defe960</key><tab>User-Defined</tab><title>formatUserIdLong</title><uiTitle/><implementation type="udf"><javaText>int j=0;
for(int i=0; i&lt;subty.length; i++)
{
	if	(subty[i].equals("0010") ) 
	{
		userid_out.addValue(useridlong[i]);
	
	 }

	else if	(subty[i].equals("0020") ) 
